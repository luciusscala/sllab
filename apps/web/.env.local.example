# Supabase — copy to .env.local and fill in.
# Server-only: these are read in Server Components and Server Actions, never
# shipped to the browser, so no NEXT_PUBLIC_ prefix.

# Project URL from Project Settings -> Data API. Origin only, no path:
# https://<project-ref>.supabase.co
SUPABASE_URL=

# Publishable key (sb_publishable_...) from Project Settings -> API Keys.
# Respects RLS. People sign in with it and every page reads as the signed-in
# person, so what each one sees is decided by the database's policies.
SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) from Project Settings -> API Keys.
# It BYPASSES RLS, so it must never gain a NEXT_PUBLIC_ prefix. Used only by
# the admin dashboard, behind requireAdmin().
SUPABASE_SECRET_KEY=

# Storage bucket holding team crests, referenced by teams.logo_path.
SUPABASE_LOGO_BUCKET=

# --- Platform API ------------------------------------------------------------
# Where reminders are sent from (apps/api). Defaults to https://api.sllab.io;
# set http://localhost:8787 to use a local `npm run dev` of the API.
# API_URL=
