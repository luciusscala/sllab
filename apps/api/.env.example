# Copy to .env for `npm run dev`. On Railway, set these as service variables.

# Project URL from Supabase -> Project Settings -> Data API. Origin only:
# https://<project-ref>.supabase.co
SUPABASE_URL=

# Secret key (sb_secret_...) from Project Settings -> API Keys. It bypasses the
# database's access rules, so it lives only here: never in an app or a browser.
SUPABASE_SECRET_KEY=

# From the Twilio Console. Account SID (AC...) and Auth Token are on the home
# page; the Messaging Service SID (MG...) is under Messaging -> Services, and
# that service's sender pool holds the number reminders come from.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Railway sets this itself. Locally it defaults to 8787.
# PORT=8787
