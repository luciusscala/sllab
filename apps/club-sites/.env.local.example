# Supabase — copy to .env.local and fill in.
# Server-only: these are read in Server Components and at build time, never
# shipped to the browser, so no NEXT_PUBLIC_ prefix.

# Project URL from Project Settings -> Data API. Origin only, no path:
# https://<project-ref>.supabase.co
SUPABASE_URL=

# Publishable key (sb_publishable_...) from Project Settings → API Keys.
# Respects RLS: the site reads only what the database makes public.
SUPABASE_PUBLISHABLE_KEY=

# Storage bucket holding team crests, referenced by teams.logo_path.
SUPABASE_LOGO_BUCKET=
