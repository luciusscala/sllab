# Supabase — copy to .env.local and fill in.
# Server-only: these are read in Server Components and at build time, never
# shipped to the browser, so no NEXT_PUBLIC_ prefix.

# Project URL from Project Settings -> Data API. Origin only, no path:
# https://<project-ref>.supabase.co
SUPABASE_URL=

# Publishable key (sb_publishable_...) from Project Settings → API Keys.
# Respects RLS. The public pages read with it, and the team app signs people
# in with it, so what each person sees is decided by the database's policies.
SUPABASE_PUBLISHABLE_KEY=

# Storage bucket holding team crests, referenced by teams.logo_path.
SUPABASE_LOGO_BUCKET=

# Secret key (sb_secret_...) from Project Settings -> API Keys.
# Server-only: it BYPASSES RLS, so it must never gain a NEXT_PUBLIC_ prefix.
# Used by the admin dashboard, and to look up phone numbers for reminders.
SUPABASE_SECRET_KEY=

# --- Team app subdomain -----------------------------------------------------
# The hostname the team app answers on, e.g. app.ucsdmcs.com. Set it in
# production and /team on the main site redirects there; leave it unset and
# /team keeps working in place, which is what localhost and previews want.
# Any `app.` host is recognised as the app either way, so app.localhost:3000
# works locally without this. It also sets the sign-in cookie's domain to the
# parent (".ucsdmcs.com"), so one sign-in covers the site and the app.
APP_HOST=

# --- SMS reminders (Twilio) -------------------------------------------------
# Account SID and Auth Token from the Twilio Console home page. Server-only.
# Sign-in codes are sent by Supabase Auth with its own Twilio settings (see
# supabase/config.toml); these are for the reminders captains send.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The Messaging Service (MG...) whose sender pool holds the club's number.
# It also handles STOP/HELP replies.
TWILIO_MESSAGING_SERVICE_SID=
